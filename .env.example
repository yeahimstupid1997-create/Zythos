DATABASE_URL=file:./db/custom.db

# The selected provider is stored by the application settings UI.
# Add keys for every provider that should participate in rate-limit fallback.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional provider-specific endpoints and model overrides.
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=
GOOGLE_MODEL=
ANTHROPIC_MODEL=
OPENROUTER_MODEL=

# Comma-separated order used after the selected provider is rate limited.
AI_PROVIDER_FALLBACKS=openai,anthropic,google,openrouter,zai

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Vexor